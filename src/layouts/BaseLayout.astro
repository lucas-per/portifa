---
import '../styles/tokens/primitives.css';
import '../styles/tokens/fonts.css';
import '../styles/tokens/semantics.css';
import '../styles/tokens/typography.css';
import plusJakartaSansUrl from '../assets/fonts/plus-jakarta-sans-variable.woff2';
import dmSansUrl from '../assets/fonts/dm-sans-variable.woff2';
import Header from '../components/layout/Header.astro';
import HeaderMobile from '../components/layout/HeaderMobile.astro';
import Footer from '../components/layout/Footer.astro';
import FooterMobile from '../components/layout/FooterMobile.astro';

interface Props {
  title: string;
  description?: string;
  /**
   * Caminho da página (ex.: '/projetos/paletaria/'). Quando vem,
   * vira o og:url e o canonical. Sem ele, o og:url continua apontando para a
   * home e não há canonical, como antes.
   */
  path?: string;
  /**
   * Para páginas que guardam estado no hash e chamam history.replaceState a
   * cada mudança (a Paletaria): o Umami ignora o hash e não conta um
   * pageview por ajuste.
   */
  umamiExcludeHash?: boolean;
}

const {
  title,
  description = 'Portfólio de Lucas Pereira, Product Designer.',
  path,
  umamiExcludeHash = false,
} = Astro.props;
const pageUrl = path ? new URL(path, 'https://lpereira.me').href : 'https://lpereira.me/';
---

<!doctype html>
<html lang="pt">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" as="font" type="font/woff2" href={plusJakartaSansUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={dmSansUrl} crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {path && <link rel="canonical" href={pageUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://lpereira.me/og-image.png" />
    <meta property="og:image:width" content="600" />
    <meta property="og:image:height" content="600" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://lpereira.me/og-image.png" />
    {import.meta.env.PUBLIC_UMAMI_WEBSITE_ID && (
      <script
        defer
        src="https://cloud.umami.is/script.js"
        data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID}
        data-exclude-hash={umamiExcludeHash ? 'true' : undefined}
      ></script>
    )}
    <style>
      body {
        margin: 0;
        background-color: var(--surface-bg-off-white-primary);
      }

      /* Texto ampliado: palavra maior que a caixa quebra em vez de vazar do
         cartão ou da página. break-word (não anywhere), como nas classes de
         título: não muda o tamanho mínimo dos itens flex e grid, então a 100%
         nada se move. :where() deixa a especificidade de um seletor de tipo.
         Os títulos (h1 a h6) entram para os que não usam as classes de título
         (ex.: os h3 em text-body-lg-strong dos cases). */
      :global(main :where(p, li, figcaption, dd, dt, h1, h2, h3, h4, h5, h6)) {
        overflow-wrap: break-word;
      }
    </style>
  </head>
  <body>
    <Header />
    <HeaderMobile />
    <main>
      <slot />
    </main>
    <Footer />
    <FooterMobile />
  </body>
</html>
