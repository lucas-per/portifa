---
import Button from '../ui/Button.astro';
import logo from '../../assets/icons/logo.svg';
import logoReduced from '../../assets/icons/logo-reduced.svg';
import HeaderLink from './HeaderLink.astro';
import { getAriaCurrent, getHeaderSections } from '../../config/navigation';
import { getHeaderLinkText } from '../../utils/header-link';
import mailIcon from '../../assets/icons/mail-on-accent.svg';
import { getContact } from '../../config/contact';

const sections = getHeaderSections();
const email = getContact('email');
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__logo clickable-link-internal-home">
      <img
        class="site-header__logo-full"
        src={logo.src}
        width="308"
        height="58"
        alt="Lucas Pereira"
      />
      <img
        class="site-header__logo-reduced"
        src={logoReduced.src}
        width="54"
        height="46"
        alt="Lucas Pereira"
      />
    </a>
    <div class="site-header__actions">
      <div class="site-header__pages">
        {sections.map((section) => (
          <HeaderLink
            href={section.path}
            text={getHeaderLinkText(section, false).text}
            current={getAriaCurrent(Astro.url.pathname, section.path)}
            class={`clickable-link-internal-${section.key}`}
          />
        ))}
      </div>
      <div class="site-header__cta">
        <Button href="/#sobre-mim" variant="outline-accent" class="clickable-anchor-aboutme">
          Sobre mim
        </Button>
        <Button href={email.href} variant="filled-accent" class="clickable-mailto-header">
          Contato
          <Fragment slot="icon">
            <img src={mailIcon.src} width="24" height="24" alt="" />
          </Fragment>
        </Button>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    width: 100%;
    border-bottom: 5px solid var(--border-accent-strong);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--scale-x8);
    box-sizing: border-box;
    max-width: 1440px;
    margin: 0 auto;
    /* Tablet: o Figma só tem 1440 e 360. Aqui o padding lateral acompanha o
       do mobile, senão o cabeçalho não cabe em 768px. */
    padding: var(--scale-x8) var(--scale-x5);
  }

  .site-header__logo {
    display: inline-flex;
    flex-shrink: 0;
  }

  .site-header__logo-full {
    display: none;
  }

  /* Figma row-btns (605:1165): 56px entre os links e os botões. Abaixo do
     ponto de quebra do logo completo (tablet, sem frame no Figma), 32px: com
     Paletaria e UaiUI, 56px deixariam só 3px de folga em 768px. */
  .site-header__actions {
    display: flex;
    gap: var(--scale-x8);
    align-items: center;
  }

  .site-header__pages {
    display: flex;
    gap: var(--scale-x8);
    align-items: center;
  }

  /* Figma row-cta (605:1042): 32px entre "Sobre mim" e "Contato". */
  .site-header__cta {
    display: flex;
    gap: var(--scale-x8);
    align-items: center;
  }

  /* Logo completo, padding de 88px e 56px entre links e botões (Figma
     98:398) a partir de 1184px: com Paletaria e UaiUI o cabeçalho precisa
     de 1140px, mais 15px da barra de rolagem, mais folga. Abaixo disso, logo
     reduzido (o do mobile), padding de 20px e 32px entre links e botões. */
  @media (min-width: 1184px) {
    .site-header__inner {
      padding: var(--scale-x8) var(--scale-x20);
    }

    .site-header__actions {
      gap: var(--scale-x14);
    }

    .site-header__logo-full {
      display: block;
    }

    .site-header__logo-reduced {
      display: none;
    }
  }

  /* No mobile, o header vira o layout próprio de HeaderMobile.astro
     (Figma: header-mobile, node 254:1007) — não é este componente
     encolhendo, então ele só some abaixo do breakpoint. */
  @media (max-width: 767px) {
    .site-header {
      display: none;
    }
  }
</style>
