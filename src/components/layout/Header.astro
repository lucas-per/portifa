---
import Button from '../ui/Button.astro';
import logo from '../../assets/icons/logo.svg';
import mailIcon from '../../assets/icons/mail-on-accent.svg';
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__logo clickable-link-internal-home">
      <img src={logo.src} width="304" height="58" alt="Lucas Pereira" />
    </a>
    <div class="site-header__cta">
      <Button href="#sobre-mim" variant="outline-accent" class="clickable-anchor-aboutme">
        Sobre mim
      </Button>
      <Button href="mailto:oi@lpereira.me" variant="filled-accent" class="clickable-mailto-header">
        Contato
        <Fragment slot="icon">
          <img src={mailIcon.src} width="24" height="24" alt="" />
        </Fragment>
      </Button>
    </div>
  </div>
</header>

<style>
  .site-header {
    width: 100%;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--scale-x8);
    box-sizing: border-box;
    max-width: 1440px;
    margin: 0 auto;
    padding: var(--scale-x8) var(--scale-x20);
  }

  .site-header__logo {
    display: inline-flex;
  }

  .site-header__cta {
    display: flex;
    gap: var(--scale-x12);
    align-items: center;
  }

  /* No mobile, o header vira o layout próprio de HeaderMobile.astro
     (Figma: header-mobile, node 254:1007) — não é este componente
     encolhendo, então ele só some abaixo do breakpoint. */
  @media (max-width: 767px) {
    .site-header {
      display: none;
    }
  }
</style>
