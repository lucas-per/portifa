---
import { getCollection } from 'astro:content';
import CaseCard from './CaseCard.astro';

// Ordem visual da Home no Figma (esquerda -> direita), não a ordem
// alfabética dos arquivos: Redesign, Jornada de Pagamentos, GoSafe DS.
const homeCaseOrder = ['redesign', 'jornada-pagamentos', 'gosafe-ds'];

const cases = (await getCollection('cases', (entry) => entry.id !== 'exemplo-case')).sort(
  (a, b) => homeCaseOrder.indexOf(a.id) - homeCaseOrder.indexOf(b.id)
);
---

<div class="cases-preview">
  <h2 class="text-title-h2">Cases selecionados</h2>
  <div class="cases-preview__grid">
    {cases.map((caseEntry) => (
      <CaseCard
        title={caseEntry.data.title}
        shortDescription={caseEntry.data.shortDescription}
        status={caseEntry.data.status}
        tags={caseEntry.data.tags}
        highlights={caseEntry.data.highlights}
        shadow={caseEntry.id === 'redesign' ? 'accent' : 'neutral'}
      />
    ))}
  </div>
</div>

<style>
  .cases-preview {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x11);
    width: 100%;
    color: var(--text-body-primary-strong);
  }

  .cases-preview__grid {
    display: flex;
    /* gap funciona como piso mínimo (nunca menor que scale-x6/24px) quando
       combinado com justify-content: space-between — o space-between
       distribui qualquer espaço adicional entre os cards; os cards (sem
       flex-grow) mantêm largura própria em vez de absorver esse espaço. */
    gap: var(--scale-x6);
    justify-content: space-between;
    /* Altura igual entre os 3 cards, dinâmica: a linha assume a altura do
       card com mais conteúdo (sem height fixa) e align-items: stretch
       estica os demais até ela — recalcula sozinho quando o conteúdo de
       qualquer card mudar, sem precisar de um card "de referência". */
    align-items: stretch;
  }

  .cases-preview__grid > :global(.case-card) {
    /* Largura fixa e igual entre os 3 cards (Figma, node 31:704:
       394.667px cada), independente da quantidade de texto — flex-grow
       e flex-shrink em 0 pra não depender do conteúdo nem ser absorvida
       pelo space-between. Não usa calc((100% - gaps) / 3): isso
       consumiria 100% do espaço disponível, sempre deixando exatamente
       o gap mínimo (24px) e nunca sobra pro space-between distribuir —
       com largura fixa, qualquer espaço além da soma dos 3 cards +
       gaps mínimos fica livre pro gap crescer. */
    flex: 0 0 394.667px;
  }
</style>
