---
import { Image } from 'astro:assets';
import CasesPreview from './CasesPreview.astro';
import avatar from '../../assets/home/avatar.png';
---

<section class="hero">
  <div class="hero__inner">
    <div class="hero__headline">
      <p class="hero__title text-title-display">
        Há alguns anos transformando{' '}
        <span class="hero__title--accent">produtos complexos</span> em experiências
        de <span class="hero__title--accent">alto impacto</span>
      </p>
      <div class="hero__avatar-frame hidden-mobile-avatar-frame">
        <Image src={avatar} alt="Foto de Lucas Pereira" width={256} height={256} loading="eager" />
      </div>
    </div>
    <CasesPreview />
  </div>
</section>

<style>
  .hero {
    width: 100%;
    background-color: var(--surface-bg-neutral-subtle);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x16);
    box-sizing: border-box;
    max-width: 1440px;
    margin: 0 auto;
    padding: var(--scale-x12) var(--scale-x20);
  }

  .hero__headline {
    display: flex;
    gap: var(--scale-x12);
    align-items: flex-start;
  }

  .hero__title {
    flex: 1;
    /* .text-title-display tem line-height 1.24 > 1, então o line-box do
       browser inclui um "leading" acima do cap-height que o Figma não conta
       no bounding box do texto — compensa pra alinhar com o topo do avatar. */
    margin-top: calc((1 - var(--line-height-compact)) / 2 * 1em);
    color: var(--text-body-primary-strong);
  }

  .hero__title--accent {
    color: var(--text-body-accent-subtle);
  }

  .hero__avatar-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background-color: var(--surface-bg-avatar-frame);
    border: 3px solid var(--border-neutral-strong);
    box-shadow: var(--shadow-layout-img);
  }

  @media (max-width: 767px) {
    .hero__inner {
      gap: var(--scale-x14);
      padding: var(--scale-x11) var(--scale-x5);
    }

    .hero__title {
      margin-top: 0;
    }

    .hidden-mobile-avatar-frame {
      display: none;
    }
  }
</style>
