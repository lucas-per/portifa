---
import { Image } from 'astro:assets';
import CasesPreview from './CasesPreview.astro';
import avatar from '../../assets/home/avatar.png';
---

<section class="hero">
  <div class="hero__inner">
    <div class="hero__headline">
      <p class="hero__title text-title-display">
        Há alguns anos transformando{' '}
        <span class="hero__title--accent">produtos complexos</span> em experiências
        de <span class="hero__title--accent">alto impacto</span>
      </p>
      <div class="hero__avatar-frame hidden-mobile-avatar-frame">
        <Image src={avatar} alt="Foto de Lucas Pereira" width={256} height={256} loading="eager" />
      </div>
    </div>
    <CasesPreview />
  </div>
</section>

<style>
  .hero {
    width: 100%;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x16);
    box-sizing: border-box;
    max-width: 1440px;
    margin: 0 auto;
    padding: var(--scale-x12) var(--scale-x20);
  }

  .hero__headline {
    display: flex;
    gap: var(--scale-x12);
    align-items: flex-start;
  }

  .hero__title {
    flex: 1;
    /* .text-title-display tem line-height 1.24 > 1, então o line-box do
       browser inclui um "leading" acima do cap-height que o Figma não conta
       no bounding box do texto — compensa pra alinhar com o topo do avatar. */
    margin-top: calc((1 - var(--line-height-compact)) / 2 * 1em);
    /* Texto ampliado: com o título em coluna (abaixo de 960px) a caixa não
       passa da largura da linha e o break-word da classe quebra a palavra
       mais longa ("transformando" tem 923px a 200%) em vez de vazar. */
    max-width: 100%;
    color: var(--text-body-primary-strong);
  }

  .hero__title--accent {
    color: var(--text-body-accent-subtle);
  }

  .hero__avatar-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background-color: var(--surface-bg-avatar-frame);
    border: 2px solid var(--tag-border-subtle);
    box-shadow: var(--shadow-layout-img);
  }

  /* Abaixo de 960px o título (a palavra mais longa tem 455px) e o avatar
     de 260px não cabem lado a lado: o avatar desce para baixo do título,
     alinhado à esquerda, com o mesmo gap. */
  @media (max-width: 959px) {
    .hero__headline {
      flex-direction: column;
    }
  }

  /* A partir de 960px, com texto ampliado: o avatar desce para baixo do
     título (mesmo gap, alinhado à esquerda, como abaixo de 960px) só quando
     a palavra mais longa não cabe ao lado dele. A base min-content é o que
     decide a quebra de linha; o min-width: 0 deixa o título, sozinho na
     linha, ficar mais estreito que a palavra (que então quebra). A 100% a
     palavra cabe (455 + 48 + 260px), nada quebra e o título cresce até o
     mesmo tamanho de antes. */
  @media (min-width: 960px) {
    .hero__headline {
      flex-wrap: wrap;
    }

    .hero__title {
      flex-basis: min-content;
      min-width: 0;
    }
  }

  @media (max-width: 767px) {
    .hero__inner {
      gap: var(--scale-x14);
      padding: var(--scale-x11) var(--scale-x5);
    }

    .hero__title {
      margin-top: 0;
    }

    .hidden-mobile-avatar-frame {
      display: none;
    }
  }
</style>
