---
import type { ImageMetadata } from 'astro';
import CaseImage from '../../ui/CaseImage.astro';
import { inlineMarkup } from '../../../utils/inline-markup';

interface Flow {
  title: string;
  paragraphs: string[];
  images: ImageMetadata[];
  caption: string;
}

interface Props {
  intro: string;
  flows: Flow[];
}

const { intro, flows } = Astro.props;
---

<section class="case-delivery-flows" id="myrole">
  <h2 class="text-title-h3">Delivery</h2>
  <div class="case-delivery-flows__subsections">
    <p class="case-delivery-flows__intro text-body-md" set:html={inlineMarkup(intro)} />
    {flows.map((flow) => (
      <div class="case-delivery-flows__flow">
        <h3 class="text-title-h4">{flow.title}</h3>
        <div class="case-delivery-flows__text">
          {flow.paragraphs.map((paragraph) => (
            <p class="text-body-md" set:html={inlineMarkup(paragraph)} />
          ))}
        </div>
        <figure class="case-delivery-flows__figure">
          <div class="case-delivery-flows__images">
            {flow.images.map((img) => (
              <CaseImage
                src={img}
                alt=""
                width={284}
                widths={[284, 568, 720]}
                sizes="(max-width: 767px) calc(100vw - 40px), 284px"
              />
            ))}
          </div>
          <figcaption class="text-body-caption">{flow.caption}</figcaption>
        </figure>
      </div>
    ))}
  </div>
</section>

<style>
  .case-delivery-flows {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x6);
    color: var(--text-body-primary-strong);
    padding-left: var(--scale-x12);
  }

  /* col-subsections (Figma 577:356): intro e um bloco por fluxo. */
  .case-delivery-flows__subsections {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x8);
  }

  .case-delivery-flows__intro {
    color: var(--text-body-neutral-strong);
  }

  .case-delivery-flows__flow {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x5);
  }

  .case-delivery-flows__text {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x3);
    color: var(--text-body-neutral-strong);
  }

  .case-delivery-flows__figure {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x2);
    margin: 0;
  }

  .case-delivery-flows__figure figcaption {
    color: var(--text-body-neutral-strong);
    text-transform: uppercase;
  }

  .case-delivery-flows__images {
    display: flex;
    gap: var(--scale-x10);
    align-items: flex-start;
  }

  /* <picture> é o item flex (o <img> fica dentro dele): os 3 preenchem a
     linha igualmente (Fill no Figma, proporção 720:1600 dos próprios PNGs).
     Borda de 2px, igual às demais imagens (o stroke dessas telas no Figma
     está em 1px, mas a decisão do projeto é uniformizar em 2px). */
  .case-delivery-flows__images :global(picture) {
    flex: 1 1 0%;
    min-width: 0;
    display: block;
  }

  .case-delivery-flows__images :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 2px solid var(--border-neutral-strong);
    box-shadow: var(--shadow-layout-img);
  }

  @media (max-width: 767px) {
    .case-delivery-flows {
      /* 20px (Figma): o inset vive aqui dentro, não em
         .case-layout__content — ver comentário em [slug].astro sobre
         os dividers estreitos entre seções. */
      padding-left: var(--scale-x5);
    }

    .case-delivery-flows__images {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
