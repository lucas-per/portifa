---
import { inlineMarkup } from '../../../utils/inline-markup';

interface Props {
  intro: string;
  hypothesis?: string;
  hypothesisCard?: string;
  risksIntro?: string;
  risks: string[];
  kpis?: string;
}

const { intro, hypothesis, hypothesisCard, risksIntro, risks, kpis } = Astro.props;
---

<section class="case-problems" id="problems-challenges">
  <h2 class="text-title-h3">Problema &amp; Desafios</h2>
  {hypothesisCard && (
    <div class="case-problems__card">
      <p class="text-body-md" set:html={inlineMarkup(hypothesisCard)} />
    </div>
  )}
  <div class="case-problems__text">
    <p class="text-body-md" set:html={inlineMarkup(intro)} />
    {hypothesis && <p class="text-body-md" set:html={inlineMarkup(hypothesis)} />}
    {risksIntro && <p class="text-body-md" set:html={inlineMarkup(risksIntro)} />}
    <ul class="case-problems__risks">
      {risks.map((risk) => (
        <li class="text-body-md" set:html={inlineMarkup(risk)} />
      ))}
    </ul>
    {kpis && <p class="text-body-md" set:html={inlineMarkup(kpis)} />}
  </div>
</section>

<style>
  .case-problems {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x5);
    color: var(--text-body-primary-strong);
    padding-left: var(--scale-x12);
  }

  .case-problems__card {
    padding: var(--scale-x6);
    background-color: var(--surface-bg-off-white-primary);
    border: 2px solid var(--border-neutral-strong);
    box-shadow: var(--shadow-layout-accent);
    color: var(--text-body-neutral-strong);
  }

  .case-problems__text {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x3);
    color: var(--text-body-neutral-strong);
  }

  .case-problems__risks {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x2);
    margin: 0;
    padding-left: var(--scale-x6);
  }

  @media (max-width: 767px) {
    .case-problems {
      /* 20px (Figma): o inset vive aqui dentro, não em
         .case-layout__content — ver comentário em [slug].astro sobre
         os dividers estreitos entre seções. */
      padding-left: var(--scale-x5);
    }
  }
</style>
