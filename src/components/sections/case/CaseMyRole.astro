---
import { inlineMarkup } from '../../../utils/inline-markup';

interface Props {
  title: string;
  paragraphs: string[];
}

const { title, paragraphs } = Astro.props;
---

<!-- Subseção do Contexto (Figma, col-myrole dentro de col-subsections):
     o recuo lateral vem de .case-context. O id fica para âncoras antigas. -->
<div class="case-my-role" id="my-role">
  <h3 class="text-title-h4">{title}</h3>
  <div class="case-my-role__text">
    {paragraphs.map((paragraph) => (
      <p class="text-body-md" set:html={inlineMarkup(paragraph)} />
    ))}
  </div>
</div>

<style>
  .case-my-role {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x5);
    color: var(--text-body-primary-strong);
  }

  .case-my-role__text {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x3);
    color: var(--text-body-neutral-strong);
  }
</style>
