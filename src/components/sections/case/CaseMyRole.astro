---
import { inlineMarkup } from '../../../utils/inline-markup';

interface Props {
  title: string;
  paragraphs: string[];
}

const { title, paragraphs } = Astro.props;
---

<section class="case-my-role" id="my-role">
  <h3 class="text-title-h4">{title}</h3>
  <div class="case-my-role__text">
    {paragraphs.map((paragraph) => (
      <p class="text-body-md" set:html={inlineMarkup(paragraph)} />
    ))}
  </div>
</section>

<style>
  .case-my-role {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x5);
    color: var(--text-body-primary-strong);
    padding-left: var(--scale-x12);
  }

  .case-my-role__text {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x3);
    color: var(--text-body-neutral-strong);
  }

  @media (max-width: 767px) {
    .case-my-role {
      /* 20px (Figma): o inset vive aqui dentro, não em
         .case-layout__content — ver comentário em [slug].astro sobre
         os dividers estreitos entre seções. */
      padding-left: var(--scale-x5);
    }
  }
</style>
