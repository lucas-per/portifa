---
import type { ImageMetadata } from 'astro';
import CaseImage from '../../ui/CaseImage.astro';
import Tag from '../../ui/Tag.astro';
import CaseMyRole from './CaseMyRole.astro';
import { inlineMarkup } from '../../../utils/inline-markup';

interface Props {
  description: string[];
  image: ImageMetadata;
  alt: string;
  /** Largura da imagem no Figma: tamanho do HTML inicial, antes do ajuste. */
  imageWidth: number;
  /** Texto da tag sobre o canto superior esquerdo da imagem (Figma 573:690 / 573:764). */
  tag?: string;
  /** "Meu papel" como subseção do Contexto (Figma, col-subsections do case Pagamentos). */
  myRole?: { title: string; paragraphs: string[] };
  optimized?: boolean;
}

const { description, image, alt, imageWidth, tag, myRole, optimized = false } = Astro.props;

// Proporção da imagem (largura ÷ altura), lida pelo script de ajuste.
const ratio = image.width / image.height;
---

<section class="case-context" id="context">
  <h2 class="text-title-h3">Contexto</h2>
  <div class="case-context__subsections">
    <div class="case-context__row" data-context-fit>
      <div class="case-context__text" data-context-fit-text>
        {description.map((paragraph) => (
          <p class="text-body-md" set:html={inlineMarkup(paragraph)} />
        ))}
      </div>
      <div
        class="case-context__media"
        data-context-fit-media
        data-ratio={ratio}
        style={`width: ${imageWidth}px; aspect-ratio: ${image.width} / ${image.height};`}
      >
        {/*
          O tamanho exibido vem do CSS: no desktop, a largura do Figma no
          HTML inicial, ajustada depois pelo script abaixo; no mobile, a
          largura total. width aqui é a resolução gerada: 240 (1x) +
          480/960 no case otimizado, a largura nativa no Redesign (<Image>
          simples). Os atributos width/height do <img> saem na proporção
          da imagem.
        */}
        <CaseImage
          src={image}
          alt={alt}
          width={optimized ? 240 : image.width}
          optimized={optimized}
          widths={[240, 480, 960]}
          sizes="(max-width: 767px) calc(100vw - 40px), 240px"
        />
        {tag && (
          <span class="case-context__tag" aria-hidden="true">
            <Tag variant="secondary" type="outlined" size="mobile">{tag}</Tag>
          </span>
        )}
      </div>
    </div>
    {myRole && <CaseMyRole {...myRole} />}
  </div>
</section>

<style>
  .case-context {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x6);
    color: var(--text-body-primary-strong);
    padding-left: var(--scale-x12);
  }

  /* col-subsections (Figma 577:353): texto+imagem e "Meu papel". No
     Redesign só há o primeiro bloco, e o gap não tem efeito. */
  .case-context__subsections {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x8);
  }

  .case-context__row {
    display: flex;
    gap: var(--scale-x10);
    align-items: flex-start;
  }

  .case-context__text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--scale-x3);
    color: var(--text-body-neutral-strong);
  }

  /* width e aspect-ratio inline: a largura do Figma no HTML inicial,
     depois a do script; a altura sai da proporção. Alinhada ao topo do
     texto: com a largura no máximo (240px), fica mais baixa que ele. */
  .case-context__media {
    position: relative;
    flex: none;
  }

  /* A imagem preenche a caixa em position:absolute, sem contribuir com
     tamanho próprio: a caixa sai só da largura + aspect-ratio. Com a
     imagem no fluxo, o WebKit usava a altura do layout anterior como
     mínimo automático do item flex e a caixa saía fora da proporção. */
  .case-context__media :global(picture),
  .case-context__media :global(img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  /* border-box: o projeto não tem reset de box-sizing, então sem isso a
     borda de 2px somaria 4px à largura da imagem. */
  .case-context__media :global(img) {
    box-sizing: border-box;
    border: 2px solid var(--tag-border-subtle);
    box-shadow: var(--shadow-layout-img);
  }

  /* Sobre a imagem, sem ocupar altura (Figma desktop: top 8, left 8; o
     Figma mobile ainda tem top 4, mas o CSS é um só para os dois). */
  .case-context__tag {
    position: absolute;
    top: var(--scale-x2);
    left: var(--scale-x2);
    display: flex;
  }

  @media (max-width: 767px) {
    .case-context {
      /* 20px (Figma, node 275:491 "col-context"): o inset vive aqui
         dentro, não em .case-layout__content — ver comentário em
         [slug].astro sobre os dividers estreitos entre seções. */
      padding-left: var(--scale-x5);
    }

    /* Empilhado: imagem abaixo do texto, na largura total. */
    .case-context__row {
      flex-direction: column;
    }

    /* min-width vence o width inline (desktop) sem !important. */
    .case-context__media {
      min-width: 100%;
    }
  }
</style>

<script>
  import { fitContextImage } from '../../../utils/context-image-fit';

  // Ajusta a largura da imagem para a altura dela acompanhar a do texto
  // (no máximo 3 iterações por ciclo; mínimo 120px, máximo de 240px ou 26%
  // do bloco linha, o que for menor). Ver
  // utils/context-image-fit.ts. Só no desktop: abaixo de 768px o bloco
  // empilha e o min-width: 100% do CSS se sobrepõe à largura inline.
  const desktop = window.matchMedia('(min-width: 768px)');

  document.querySelectorAll<HTMLElement>('[data-context-fit]').forEach((row) => {
    const text = row.querySelector<HTMLElement>('[data-context-fit-text]');
    const media = row.querySelector<HTMLElement>('[data-context-fit-media]');
    if (!text || !media) return;
    const ratio = Number(media.dataset.ratio);
    let width = parseFloat(media.style.width);
    // Tamanhos deixados pelo último ajuste: o ResizeObserver dispara
    // também por causa da largura que o próprio ajuste aplica, e esse
    // disparo não abre um ciclo novo (é isso que impede o loop).
    let settled = { row: -1, width: -1, height: -1 };
    const sizes = () => {
      const t = text.getBoundingClientRect();
      return { row: row.getBoundingClientRect().width, width: t.width, height: t.height };
    };

    const fit = () => {
      if (!desktop.matches) return;
      ({ width } = fitContextImage({
        measureTextHeight: () => text.getBoundingClientRect().height,
        applyWidth: (next) => {
          media.style.width = `${next}px`;
        },
        currentWidth: width,
        ratio,
        rowWidth: row.getBoundingClientRect().width,
      }));
      settled = sizes();
    };

    const observer = new ResizeObserver(() => {
      const now = sizes();
      const same = (a: number, b: number) => Math.abs(a - b) < 0.5;
      if (same(now.row, settled.row) && same(now.width, settled.width) && same(now.height, settled.height)) return;
      fit();
    });
    observer.observe(text);
    observer.observe(row);

    // A altura do texto muda quando a fonte web substitui a de fallback.
    document.fonts.ready.then(fit);
    desktop.addEventListener('change', fit);
    fit();
  });
</script>
