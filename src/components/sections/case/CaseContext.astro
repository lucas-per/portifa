---
import type { ImageMetadata } from 'astro';
import CaseImage from '../../ui/CaseImage.astro';
import CaseMyRole from './CaseMyRole.astro';
import { inlineMarkup } from '../../../utils/inline-markup';

interface Props {
  description: string[];
  image: ImageMetadata;
  caption: string;
  /** "Meu papel" como subseção do Contexto (Figma, col-subsections do case Pagamentos). */
  myRole?: { title: string; paragraphs: string[] };
  optimized?: boolean;
}

const { description, image, caption, myRole, optimized = false } = Astro.props;
---

<section class="case-context" id="context">
  <h2 class="text-title-h3">Contexto</h2>
  <div class="case-context__subsections">
    <div class="case-context__row">
      <div class="case-context__text">
        {description.map((paragraph) => (
          <p class="text-body-md" set:html={inlineMarkup(paragraph)} />
        ))}
      </div>
      <figure class="case-context__figure">
        <CaseImage
          src={image}
          alt={caption}
          width={156}
          optimized={optimized}
          widths={[156, 312, 640]}
          sizes="(max-width: 767px) calc(100vw - 40px), 156px"
        />
        <figcaption class="text-body-caption">{caption}</figcaption>
      </figure>
    </div>
    {myRole && <CaseMyRole {...myRole} />}
  </div>
</section>

<style>
  .case-context {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x6);
    color: var(--text-body-primary-strong);
    padding-left: var(--scale-x12);
  }

  /* col-subsections (Figma 577:353): texto+imagem e "Meu papel". No
     Redesign só há o primeiro bloco, e o gap não tem efeito. */
  .case-context__subsections {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x8);
  }

  .case-context__row {
    display: flex;
    gap: var(--scale-x10);
    align-items: flex-start;
  }

  .case-context__text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--scale-x3);
    color: var(--text-body-neutral-strong);
  }

  .case-context__figure {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x2);
    /* A figura tem a largura da imagem (Figma 452:290, col-img-context):
       a legenda quebra dentro dela e fica alinhada à esquerda, em vez de
       centralizada e mais larga que a imagem. */
    width: 156px;
    margin: 0;
    flex-shrink: 0;
  }

  /* border-box: o projeto não tem reset de box-sizing, então sem isso a
     borda de 2px somaria 4px aos 156px e a imagem ficaria mais larga que
     a legenda. */
  .case-context__figure :global(img) {
    box-sizing: border-box;
    display: block;
    width: 100%;
    height: auto;
    border: 2px solid var(--border-neutral-strong);
    box-shadow: var(--shadow-layout-img);
  }

  .case-context__figure figcaption {
    color: var(--text-body-neutral-strong);
    text-transform: uppercase;
  }

  @media (max-width: 767px) {
    .case-context {
      /* 20px (Figma, node 275:491 "col-context"): o inset vive aqui
         dentro, não em .case-layout__content — ver comentário em
         [slug].astro sobre os dividers estreitos entre seções. */
      padding-left: var(--scale-x5);
    }

    .case-context__row {
      flex-direction: column;
    }

    .case-context__figure {
      align-self: stretch;
      width: auto;
    }
  }
</style>
