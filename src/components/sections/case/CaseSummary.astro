---
import { inlineMarkup } from '../../../utils/inline-markup';

interface Block {
  title: string;
  description: string;
}

interface Props {
  challenge: Block;
  solution: Block;
  results: Block;
}

const { challenge, solution, results } = Astro.props;
---

<section class="case-summary" id="resumo">
  <h2 class="text-title-h3">Resumo</h2>
  <div class="case-summary__grid">
    <div class="case-summary__col">
      <h3 class="case-summary__col-title case-summary__col-title--challenge text-title-h4">
        {challenge.title}
      </h3>
      <p class="case-summary__col-desc text-body-md" set:html={inlineMarkup(challenge.description)} />
    </div>
    <div class="case-summary__col">
      <h3 class="case-summary__col-title case-summary__col-title--solution text-title-h4">
        {solution.title}
      </h3>
      <p class="case-summary__col-desc text-body-md" set:html={inlineMarkup(solution.description)} />
    </div>
    <div class="case-summary__col">
      <h3 class="case-summary__col-title case-summary__col-title--results text-title-h4">
        {results.title}
      </h3>
      <p class="case-summary__col-desc text-body-md" set:html={inlineMarkup(results.description)} />
    </div>
  </div>
</section>

<style>
  .case-summary {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x6);
    color: var(--text-body-primary-strong);
    padding-left: var(--scale-x12);
  }

  /* Grid com subgrid: as três faixas de título (linha 1) e as três
     descrições (linha 2) compartilham as mesmas linhas, então as faixas
     ficam com a altura da mais alta mesmo quando um título quebra linha
     e outro não (Figma, wrap-h4-title-* com 85px nas três colunas). */
  .case-summary__grid {
    display: grid;
    /* min-content como piso: igual ao flex anterior, a coluna nunca fica
       mais estreita que a palavra mais longa (o texto não vaza do card). */
    grid-template-columns: repeat(3, minmax(min-content, 1fr));
    grid-template-rows: auto auto;
    column-gap: var(--scale-x10);
  }

  .case-summary__col {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 0;
    background-color: var(--surface-bg-off-white-primary);
    border: 2px solid var(--border-neutral-strong);
    box-shadow: var(--shadow-layout-neutral);
  }

  .case-summary__col-title {
    margin: 0;
    padding: var(--scale-x6);
    border-bottom: 2px solid var(--border-neutral-strong);
    color: var(--text-body-neutral-strong);
  }

  .case-summary__col-title--challenge {
    background-color: var(--surface-bg-tertiary-subtle);
  }

  .case-summary__col-title--solution {
    background-color: var(--surface-bg-off-white-tertiary);
  }

  .case-summary__col-title--results {
    background-color: var(--surface-bg-secondary-subtle);
  }

  .case-summary__col-desc {
    padding: var(--scale-x6);
    color: var(--text-body-neutral-strong);
  }

  @media (max-width: 767px) {
    .case-summary {
      /* 20px (Figma, node 275:472 "col-summary"): o inset vive aqui
         dentro, não em .case-layout__content — ver comentário em
         [slug].astro sobre os dividers estreitos entre seções. */
      padding-left: var(--scale-x5);
    }
  }

  /* Até 1087px (mobile e tablet): empilhado, cada card volta a ter as
     próprias linhas. Com o menu lateral, as três colunas pedem de 1021 a
     1059px de documento (o piso é a palavra mais longa de cada título);
     a 1088px todos os cases já cabem. */
  @media (max-width: 1087px) {
    .case-summary__grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      gap: var(--scale-x8);
    }

    .case-summary__col {
      grid-row: auto;
      grid-template-rows: auto auto;
    }
  }
</style>
