---
import type { ImageMetadata } from 'astro';
import CaseImage from '../../ui/CaseImage.astro';
import { inlineMarkup } from '../../../utils/inline-markup';

interface Topic {
  title: string;
  paragraphs: string[];
  image?: { src: ImageMetadata; caption: string };
}

interface Props {
  intro: string;
  topics: Topic[];
  consolidation: { title: string; description: string };
}

const { intro, topics, consolidation } = Astro.props;
---

<section class="case-discovery-topics" id="strategy-solutions">
  <h2 class="text-title-h3">Discovery</h2>
  <div class="case-discovery-topics__subsections">
    <div class="case-discovery-topics__plan">
      <p class="text-body-md" set:html={inlineMarkup(intro)} />
      {topics.map((topic) => (
        <div class="case-discovery-topics__topic">
          <div class="case-discovery-topics__topic-text">
            <h3 class="text-body-lg-strong">{topic.title}</h3>
            {topic.paragraphs.map((paragraph) => (
              <p class="text-body-md" set:html={inlineMarkup(paragraph)} />
            ))}
          </div>
          {topic.image && (
            <figure class="case-discovery-topics__figure">
              <CaseImage
                src={topic.image.src}
                alt={topic.image.caption}
                width={107}
                widths={[107, 214, 428, 800]}
                sizes="(max-width: 767px) calc(100vw - 40px), 107px"
              />
              <figcaption class="text-body-caption">{topic.image.caption}</figcaption>
            </figure>
          )}
        </div>
      ))}
    </div>
    <div class="case-discovery-topics__consolidation">
      <h3 class="text-title-h4">{consolidation.title}</h3>
      <p class="text-body-md" set:html={inlineMarkup(consolidation.description)} />
    </div>
  </div>
</section>

<style>
  .case-discovery-topics {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x6);
    color: var(--text-body-primary-strong);
    padding-left: var(--scale-x12);
  }

  /* col-subsections (Figma 577:355): plano de pesquisa e consolidação. */
  .case-discovery-topics__subsections {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x8);
  }

  .case-discovery-topics__plan {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x5);
    color: var(--text-body-neutral-strong);
  }

  .case-discovery-topics__topic {
    display: flex;
    gap: var(--scale-x10);
    align-items: flex-start;
  }

  .case-discovery-topics__topic-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--scale-x3);
  }

  .case-discovery-topics__figure {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x2);
    width: 107px;
    flex-shrink: 0;
    margin: 0;
  }

  .case-discovery-topics__figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 2px solid var(--tag-border-subtle);
    box-shadow: var(--shadow-layout-img);
  }

  .case-discovery-topics__figure figcaption {
    color: var(--text-body-neutral-strong);
    text-transform: uppercase;
  }

  .case-discovery-topics__consolidation {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x5);
    padding: var(--scale-x6);
    background-color: var(--surface-bg-off-white-primary);
    border: 2px solid var(--border-accent-subtle);
    box-shadow: var(--shadow-layout-accent);
  }

  .case-discovery-topics__consolidation > p {
    color: var(--text-body-neutral-strong);
  }

  /* Tablet com texto ampliado (ver [slug].astro): o recuo de 48px vira
     min(48px, 6,25vw). A 100% é sempre o token (6,25vw de 768px já é 48px);
     com o rem dobrado ele para em 6,25vw e devolve largura à coluna. */
  @media (min-width: 768px) and (max-width: 1087px) {
    .case-discovery-topics {
      padding-left: min(var(--scale-x12), 6.25vw);
    }
  }

  @media (max-width: 767px) {
    .case-discovery-topics {
      /* 20px (Figma): o inset vive aqui dentro, não em
         .case-layout__content — ver comentário em [slug].astro sobre
         os dividers estreitos entre seções. */
      padding-left: var(--scale-x5);
    }

    /* stretch: em coluna, o texto do tópico tem a largura da seção em vez
       de encolher ao conteúdo e crescer até a palavra mais longa (texto
       ampliado). A 100% o texto longo já enchia a linha. */
    .case-discovery-topics__topic {
      flex-direction: column;
      align-items: stretch;
    }

    .case-discovery-topics__figure {
      width: 100%;
    }

    /* border-box: sem reset no projeto, a borda de 2px somaria 4px à largura
       e a imagem invadiria o respiro de 20px da direita (ver CaseContext).
       Só no mobile: a partir de 768px a miniatura fica como está. */
    .case-discovery-topics__figure :global(img) {
      box-sizing: border-box;
    }
  }

  /* Abaixo de 360px, a largura do frame mobile do Figma: o título do card
     ("encaminhamentos", sem ponto de quebra, 217px em 24px Bold) pede 269px de
     card e a coluna útil a 320px tem 265px, então a coluna inteira estourava
     4px. Com 20px de padding (--scale-x5) em vez de 24px o card cabe, sem
     quebrar a palavra. A partir de 360px nada muda. */
  @media (max-width: 359px) {
    .case-discovery-topics__consolidation {
      padding: var(--scale-x5);
    }
  }
</style>
