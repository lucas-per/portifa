---
import Button from '../../ui/Button.astro';
import arrowLeftIcon from '../../../assets/icons/case/arrow-left.svg';
import { caseSideMenuItems as items } from '../../../utils/case-side-menu-items';
---

<nav class="side-menu" aria-label="Nesta página">
  <p class="side-menu__title text-label-sm">Nesta página</p>
  <ul class="side-menu__list">
    {items.map((item) => (
      <li class="side-menu__item" data-side-menu-item>
        <a href={item.href} class="side-menu__link text-label-md" data-side-menu-link data-target={item.href.slice(1)}>
          {item.label}
        </a>
      </li>
    ))}
  </ul>
  <Button href="/" variant="outline-accent" class="clickable-link-internal-home">
    <Fragment slot="leading-icon">
      <img src={arrowLeftIcon.src} width="24" height="24" alt="" />
    </Fragment>
    Voltar
  </Button>
</nav>

<style>
  .side-menu {
    position: sticky;
    top: var(--scale-x6);
    display: flex;
    flex-direction: column;
    gap: var(--scale-x12);
    width: 234px;
    flex-shrink: 0;
    /* Respiro interno (não no container pai) pra ficar encostado no
       divisor horizontal acima, sem lacuna — ver [slug].astro. */
    padding: var(--scale-x10) 0;
    /* O espaço até o divisor vertical vive aqui (não como gap
       compartilhado em .case-layout), porque depois do divisor o
       conteúdo precisa encostar nele sem nenhum espaço — ver [slug].astro. */
    margin-right: var(--scale-x12);
  }

  .side-menu__title {
    margin: 0;
    color: var(--text-body-neutral-strong);
  }

  .side-menu__list {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .side-menu__item {
    display: flex;
    border-left: 5px solid transparent;
    padding-left: 0;
  }

  /* Barra azul do item ativo — elemento distinto do botão em si (Figma,
     node 222:352): container recebe border-left + padding, o botão por
     dentro fica sem fundo/borda própria (ver .side-menu__link--active). */
  .side-menu__item--active {
    border-left-color: var(--border-accent-strong);
    padding-left: var(--scale-x4);
  }

  .side-menu__link {
    display: inline-flex;
    padding: var(--scale-x3) 0;
    border: 3px solid var(--button-border-primary-subtlest);
    background: var(--button-bg-primary-outline-regular);
    color: var(--text-label-primary);
    text-decoration: none;
  }

  /* Estado ativo (Figma: type=ghost, style=primary, state=active,
     nodes 82:404/253:729) — sem fundo sólido nem borda visível, só a
     cor do texto muda. A borda mantém 3px pra não deslocar o layout,
     só fica transparente. */
  .side-menu__link--active {
    background: transparent;
    border-color: var(--button-border-neutral-invisible);
    color: var(--text-label-accent);
  }

  /* No mobile, o menu lateral vira o accordion (CaseAccordion.astro,
     Figma node 299:673) — não encolhe, some abaixo do breakpoint. */
  @media (max-width: 767px) {
    .side-menu {
      display: none;
    }
  }
</style>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-side-menu-link]');
  const sections = Array.from(links)
    .map((link) => document.getElementById(link.dataset.target!))
    .filter((el): el is HTMLElement => el !== null);

  function setActive(id: string) {
    for (const link of links) {
      const isActive = link.dataset.target === id;
      link.classList.toggle('side-menu__link--active', isActive);
      link.closest('[data-side-menu-item]')?.classList.toggle('side-menu__item--active', isActive);
    }
  }

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          setActive(entry.target.id);
        }
      }
    },
    { rootMargin: '-40% 0px -55% 0px', threshold: 0 }
  );

  for (const section of sections) {
    observer.observe(section);
  }
</script>
