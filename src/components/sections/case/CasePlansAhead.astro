---
import { inlineMarkup } from '../../../utils/inline-markup';

interface Block {
  title: string;
  description: string;
}

interface Props {
  privacy?: Block;
  pains?: Block;
  paragraphs?: string[];
}

const { privacy, pains, paragraphs } = Astro.props;
---

<section class="case-plans-ahead" id="plans-ahead">
  <h2 class="text-title-h3">Visão de futuro</h2>
  {(privacy || pains) && (
    <div class="case-plans-ahead__subsections">
      {privacy && (
        <div class="case-plans-ahead__block">
          <h3 class="text-title-h4">{privacy.title}</h3>
          <p class="text-body-md">{privacy.description}</p>
        </div>
      )}
      {pains && (
        <div class="case-plans-ahead__block">
          <h3 class="text-title-h4">{pains.title}</h3>
          <p class="text-body-md">{pains.description}</p>
        </div>
      )}
    </div>
  )}
  {paragraphs && (
    <div class="case-plans-ahead__text">
      {paragraphs.map((paragraph) => (
        <p class="text-body-md" set:html={inlineMarkup(paragraph)} />
      ))}
    </div>
  )}
</section>

<style>
  .case-plans-ahead {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x6);
    color: var(--text-body-primary-strong);
    padding-left: var(--scale-x12);
  }

  .case-plans-ahead__text {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x3);
    color: var(--text-body-neutral-strong);
  }

  /* col-subsections (Figma 577:362, Redesign): Privacidade e Dores. */
  .case-plans-ahead__subsections {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x8);
  }

  .case-plans-ahead__block {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x5);
    color: var(--text-body-neutral-strong);
  }

  /* Tablet com texto ampliado (ver [slug].astro): o recuo de 48px vira
     min(48px, 6,25vw). A 100% é sempre o token (6,25vw de 768px já é 48px);
     com o rem dobrado ele para em 6,25vw e devolve largura à coluna. */
  @media (min-width: 768px) and (max-width: 1087px) {
    .case-plans-ahead {
      padding-left: min(var(--scale-x12), 6.25vw);
    }
  }

  @media (max-width: 767px) {
    .case-plans-ahead {
      /* 20px (Figma): o inset vive aqui dentro, não em
         .case-layout__content — ver comentário em [slug].astro sobre
         os dividers estreitos entre seções. */
      padding-left: var(--scale-x5);
    }
  }
</style>
