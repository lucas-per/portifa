---
import { inlineMarkup } from '../../../utils/inline-markup';

interface Highlight {
  value: string;
  label: string;
}

interface Props {
  highlights: Highlight[];
  description: string[];
}

const { highlights, description } = Astro.props;
---

<section class="case-impact" id="impact">
  <h2 class="text-title-h3">Impacto</h2>
  <div class="case-impact__body">
    <div class="case-impact__highlights">
      {highlights.map((highlight) => (
        <div class="case-impact__highlight">
          <p class="text-title-h3">{highlight.value}</p>
          <p class="text-body-md">{highlight.label}</p>
        </div>
      ))}
    </div>
    <div class="case-impact__text">
      {description.map((paragraph) => (
        <p class="text-body-md" set:html={inlineMarkup(paragraph)} />
      ))}
    </div>
  </div>
</section>

<style>
  .case-impact {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x6);
    color: var(--text-body-primary-strong);
    padding-left: var(--scale-x12);
  }

  /* col-body (Figma 577:357): números + texto, gap 20. */
  .case-impact__body {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x5);
  }

  .case-impact__highlights {
    display: flex;
    gap: var(--scale-x10);
    flex-wrap: wrap;
  }

  .case-impact__highlight {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x2);
    padding: var(--scale-x6);
    background-color: var(--surface-bg-off-white-primary);
    border: 2px solid var(--border-neutral-strong);
    box-shadow: var(--shadow-layout-neutral);
    /* 200px, mas nunca mais largo que a linha (texto ampliado: padding de
       2 × 48px e borda de 2 × 2px somados). A 100% a linha tem no mínimo
       263px e o valor é sempre 200px. */
    min-width: min(200px, 100% - var(--scale-x12) - 4px);
  }

  .case-impact__highlight p:first-child {
    color: var(--text-body-primary-strong);
  }

  .case-impact__highlight p:last-child {
    color: var(--text-body-neutral-strong);
  }

  .case-impact__text {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x3);
    color: var(--text-body-neutral-strong);
  }

  /* Tablet com texto ampliado (ver [slug].astro): o recuo de 48px vira
     min(48px, 6,25vw). A 100% é sempre o token (6,25vw de 768px já é 48px);
     com o rem dobrado ele para em 6,25vw e devolve largura à coluna. */
  @media (min-width: 768px) and (max-width: 1087px) {
    .case-impact {
      padding-left: min(var(--scale-x12), 6.25vw);
    }
  }

  @media (max-width: 767px) {
    .case-impact {
      /* 20px (Figma): o inset vive aqui dentro, não em
         .case-layout__content — ver comentário em [slug].astro sobre
         os dividers estreitos entre seções. */
      padding-left: var(--scale-x5);
    }
  }
</style>
