---
interface Props {
  href?: string;
  variant?: 'filled-accent' | 'outline-accent' | 'ghost-accent';
  external?: boolean;
  download?: boolean;
  class?: string;
}

const {
  href,
  variant = 'filled-accent',
  external = false,
  download = false,
  class: className,
} = Astro.props;
const Tag = href ? 'a' : 'button';
const hasLeadingIcon = Astro.slots.has('leading-icon');
const hasIcon = Astro.slots.has('icon');
---

<Tag
  class={['button', `button--${variant}`, className].filter(Boolean).join(' ')}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  download={download ? true : undefined}
  type={href ? undefined : 'button'}
>
  <span class="button__body">
    {hasLeadingIcon && (
      <span class="button__icon">
        <slot name="leading-icon" />
      </span>
    )}
    <span class="button__label text-label-md"><slot /></span>
    {hasIcon && (
      <span class="button__icon">
        <slot name="icon" />
      </span>
    )}
  </span>
</Tag>

<style>
  /*
    A sombra dura (neo-brutalismo) precisa ficar fixa no lugar enquanto só o
    corpo do botão se move no hover/active — por isso ela vive num ::after do
    elemento externo (que nunca recebe transform), e o corpo visível (borda,
    fundo, texto) fica num elemento interno separado, que é o único a se
    deslocar. Ver design-notes.md, "Padrão de interação — botões".
  */
  .button {
    position: relative;
    display: inline-flex;
    text-decoration: none;
    cursor: pointer;
  }

  .button::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .button__body {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--scale-x3);
    padding: var(--scale-x3) var(--scale-x6);
    border-width: 3px;
    border-style: solid;
    transition: transform 0.1s ease;
  }

  .button__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .button--filled-accent .button__body {
    background-color: var(--button-bg-accent-filled-regular);
    border-color: var(--button-border-neutral-strong);
    color: var(--text-label-on-bg-strong);
  }

  .button--filled-accent::after {
    box-shadow: var(--shadow-comp-neutral);
  }

  .button--outline-accent .button__body {
    background-color: var(--button-bg-accent-outline-regular);
    border-color: var(--button-border-accent-strong);
    color: var(--text-label-on-bg-accent);
  }

  .button--outline-accent::after {
    box-shadow: var(--shadow-comp-accent);
  }

  .button--ghost-accent .button__body {
    background-color: var(--button-bg-accent-outline-regular);
    border-color: var(--button-border-neutral-subtle);
    color: var(--text-label-on-bg-accent);
    padding: var(--scale-x3) var(--scale-none);
  }

  .button:hover .button__body {
    transform: translate(-2px, -2px);
  }

  .button:active .button__body {
    transform: translate(1px, 1px);
  }

  .button:active::after {
    box-shadow: none;
  }

  .button:focus-visible {
    outline: 2px solid var(--border-focus-strong);
    outline-offset: 2px;
  }
</style>
