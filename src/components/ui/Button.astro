---
interface Props {
  href?: string;
  variant?: 'filled-accent' | 'outline-accent' | 'ghost-accent';
  /** Referência tipográfica do label: 'md' (Desktop/Label/MD, scale-x5) ou 'sm' (Mobile/Label/MD, scale-x4) */
  size?: 'sm' | 'md';
  external?: boolean;
  download?: boolean;
  class?: string;
}

const {
  href,
  variant = 'filled-accent',
  size = 'md',
  external = false,
  download = false,
  class: className,
} = Astro.props;
const Tag = href ? 'a' : 'button';
const hasLeadingIcon = Astro.slots.has('leading-icon');
const hasIcon = Astro.slots.has('icon');
---

<Tag
  class={['button', `button--${variant}`, `button--${size}`, className].filter(Boolean).join(' ')}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  download={download ? true : undefined}
  type={href ? undefined : 'button'}
>
  {hasLeadingIcon && (
    <span class="button__icon">
      <slot name="leading-icon" />
    </span>
  )}
  <span class={`button__label text-label-${size}`}><slot /></span>
  {hasIcon && (
    <span class="button__icon">
      <slot name="icon" />
    </span>
  )}
</Tag>

<style>
  /*
    Um ::after separado pra sombra (com o corpo do botão recebendo o
    transform) parece a solução óbvia, mas introduz uma costura de subpixel
    entre duas caixas renderizadas independentemente — um fiapo do fundo da
    página aparecia entre a borda e a sombra mesmo com as duas caixas
    matematicamente idênticas (ver histórico do bug). Border e box-shadow
    ficam de volta no mesmo elemento (sem costura possível, mesma operação
    de pintura) e em vez de mover o elemento, compensamos o offset do
    box-shadow na mesma medida do deslocamento: como transform desloca o
    elemento inteiro (incluindo sua própria sombra) em bloco, aumentar o
    offset da sombra pelo valor exato do translate do hover cancela esse
    deslocamento e a sombra acaba renderizada exatamente na mesma posição
    de tela de antes — só o corpo visualmente "sobe". Ver design-notes.md,
    "Padrão de interação — botões".
  */
  .button {
    display: inline-flex;
    align-self: flex-start; /* nunca esticar em containers flex/grid do chamador */
    align-items: center;
    justify-content: center;
    gap: var(--scale-x3);
    padding: var(--scale-x3) var(--scale-x6);
    border-width: 3px;
    border-style: solid;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }

  .button__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .button--filled-accent {
    background-color: var(--button-bg-accent-filled-regular);
    border-color: var(--button-border-neutral-strong);
    color: var(--text-label-neutral-1);
    box-shadow: var(--shadow-comp-neutral);
  }

  .button--filled-accent:hover {
    box-shadow: var(--shadow-comp-neutral-hover);
  }

  .button--outline-accent {
    background-color: var(--button-bg-accent-outline-regular);
    border-color: var(--button-border-accent-strong);
    color: var(--text-label-accent);
    box-shadow: var(--shadow-comp-accent);
  }

  .button--outline-accent:hover {
    box-shadow: var(--shadow-comp-accent-hover);
  }

  .button--ghost-accent {
    background-color: transparent;
    border-color: var(--button-border-neutral-invisible);
    color: var(--text-label-accent);
    padding: var(--scale-x3) var(--scale-none);
  }

  /* size="sm" (Mobile/Label/MD) também troca o padding — o token de fonte
     sozinho não muda a altura do botão pro valor de mobile (46px). */
  .button--sm {
    padding: var(--scale-x2) var(--scale-x4);
  }

  .button:hover {
    transform: translate(-2px, -2px);
  }

  .button:active {
    transform: translate(1px, 1px);
    box-shadow: none;
  }

  .button:focus-visible {
    outline: 2px solid var(--border-focus-strong);
    outline-offset: 2px;
  }
</style>
