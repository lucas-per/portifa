---
interface Props {
  width?: string;
  height?: string;
  color?: string;
  class?: string;
  contained?: boolean;
}

const {
  width = '100%',
  height = '5px',
  color = 'var(--surface-bg-accent-strong)',
  class: className,
  contained = false,
} = Astro.props;

const barClass = ['divider', className].filter(Boolean).join(' ');
const barStyle = { width, height, backgroundColor: color };
---

{contained ? (
  <div class="divider-container">
    <div class={barClass} style={barStyle}></div>
  </div>
) : (
  <div class={barClass} style={barStyle}></div>
)}

<style>
  /* Alguns dividers (ex: entre skills e sobre-mim) não são estruturais
     full-bleed — precisam ficar presos à coluna max-width 1440 das
     seções vizinhas, não à borda real da viewport. Sem padding aqui:
     o cliente confirmou que a barra deve começar na borda esquerda do
     próprio container de 1440 (antes do respiro de 88px do conteúdo),
     não alinhada com o texto/cards que têm o padding aplicado. Isso
     também mantém o comportamento em telas ≤1440px idêntico ao atual
     (a barra encostada na borda real da viewport). */
  .divider-container {
    max-width: 1440px;
    margin: 0 auto;
  }
</style>
