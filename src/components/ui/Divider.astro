---
interface Props {
  width?: string;
  height?: string;
  color?: string;
  class?: string;
}

const {
  width = '100%',
  height = '5px',
  color = 'var(--surface-bg-accent-strong)',
  class: className,
} = Astro.props;
---

<div
  class={['divider', className].filter(Boolean).join(' ')}
  style={{ width, height, backgroundColor: color }}
></div>
