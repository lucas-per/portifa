---
/**
 * Ícones do shell da documentação (Figma, Assets do UaiUI: uai/ic-search,
 * uai/ic-chevron-down, uai/ic-menu, uai/ic-arrow-left e uai/ic-arrow-right).
 * 24x24, só traço de 3px em currentColor, cantos retos, como os do DS.
 */
interface Props {
  name: 'search' | 'chevron-down' | 'menu' | 'arrow-left' | 'arrow-right';
  class?: string;
}

const paths: Record<Props['name'], string[]> = {
  search: ['M16 10C16 13.3137 13.3137 16 10 16C6.68629 16 4 13.3137 4 10C4 6.68629 6.68629 4 10 4C13.3137 4 16 6.68629 16 10Z', 'M15 15L21 21'],
  'chevron-down': ['M6 9L12 15L18 9'],
  menu: ['M4 7H20M4 12H20M4 17H20'],
  'arrow-left': ['M20 12H5M11 18L5 12L11 6'],
  'arrow-right': ['M4 12H19M13 18L19 12L13 6'],
};

const { name, class: className } = Astro.props;
---

<svg
  class={['uaiui-docs__icon', className].filter(Boolean).join(' ')}
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="3"
  stroke-linecap="square"
  aria-hidden="true"
  focusable="false"
>
  {paths[name].map((d) => <path d={d} />)}
</svg>
