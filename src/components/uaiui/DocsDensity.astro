---
/**
 * Controle de densidade de um exemplo (Figma 704:751). Muda data-uaiui-density
 * no wrapper .uaiui: sem atributo é Desktop (o padrão), "mobile" e "compact"
 * são os outros modos dos tokens do DS. Cada exemplo tem o seu grupo de rádios
 * (name próprio: rádios de exemplos diferentes com o mesmo name virariam um
 * grupo só e quebrariam o Tab e as setas); a escolha vale para a página toda,
 * os grupos ficam sincronizados por script (docs.ts) e ela fica em
 * localStorage (uaiui-density). O script inline no fim do UaiuiDocsLayout
 * marca a opção salva antes da pintura, e o do início do wrapper já aplicou o
 * atributo.
 */
interface Props {
  /** name dos rádios: único por exemplo (vem do id estável dele). */
  name: string;
}

const { name } = Astro.props;

const densityOptions = [
  { value: 'desktop', label: 'Desktop' },
  { value: 'mobile', label: 'Mobile' },
  { value: 'compact', label: 'Compacto' },
] as const;
---

<fieldset class="uaiui-docs__density" data-density>
  <legend class="uaiui-docs__density-legend">Densidade</legend>
  <div class="uaiui-docs__segments">
    {densityOptions.map((option) => (
      <label class="uaiui-docs__segment">
        <input
          class="uaiui-docs__segment-input"
          type="radio"
          name={name}
          value={option.value}
          checked={option.value === 'desktop'}
        />
        <span class="uaiui-docs__segment-text">{option.label}</span>
      </label>
    ))}
  </div>
</fieldset>
