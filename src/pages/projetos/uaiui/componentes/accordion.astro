---
// Accordion (porte de src/pages/docs/components/accordion.astro do uaiui-ds
// v0.2.0). Textos do DS, com as mudanças registradas no design-notes.md (seção
// "UaiUI — PR B"): a instalação usa o wrapper .uaiui e o CSS do pacote.
// O CSS do componente entra só nesta página; o texto do bloco de código é o
// do próprio arquivo do pacote (?raw), sem cópia no portifa.
import 'uaiui-ds/components/accordion.css';
import css from 'uaiui-ds/components/accordion.css?raw';
import UaiuiDocsLayout from '../../../../layouts/UaiuiDocsLayout.astro';
import Example from '../../../../components/uaiui/Example.astro';
import CodeBlock from '../../../../components/uaiui/CodeBlock.astro';
import PropsTable from '../../../../components/uaiui/PropsTable.astro';
import { svg } from '../../../../components/uaiui/icons';

// O DS deixa o nível do título por conta da página. O primeiro exemplo fica logo
// abaixo do h1, então seus itens são h2 (sem id: não entram em "Nesta página");
// os exemplos de dentro de uma seção "h2" usam h3, sem pular nível.
type Level = 'h2' | 'h3';
const item = (level: Level, id: string, title: string, body: string, open = false, disabled = false) => `<div class="uai-accordion-item">
  <${level}>
    <button class="uai-accordion-trigger" id="${id}-h" aria-expanded="${open}" aria-controls="${id}-p"${disabled ? ' aria-disabled="true"' : ''}>
      <span>${title}</span>
      ${svg('chevron')}
    </button>
  </${level}>
  <div class="uai-accordion-panel" id="${id}-p" role="region" aria-labelledby="${id}-h"${open ? '' : ' hidden'}>${body}</div>
</div>`;
const basic = `<div class="uai-accordion">
${item('h2', 'a1', 'O que é o UaiUI?', 'Um sistema de design com bordas retas, sombras duras e temas por tokens.', true)}
${item('h2', 'a2', 'Posso trocar as cores?', 'Sim. Troque os primitivos e os componentes seguem, porque só leem tokens.')}
${item('h2', 'a3', 'Funciona no escuro?', 'Sim. Todos os pares de cor foram conferidos nos modos Claro e Escuro.')}
</div>`;
const single = item('h3', 's1', 'Seção sozinha', 'Um item isolado, sem grupo.', true);
const disabled = `<div class="uai-accordion">
${item('h3', 'd1', 'Seção disponível', 'Conteúdo visível.', true)}
${item('h3', 'd2', 'Seção indisponível', 'Este conteúdo não abre.', false, true)}
</div>`;
const rows = [
  { name: 'aria-expanded', type: 'true | false', default: 'false', description: 'No <code>button</code>. Aberto ou fechado se vê pela seta (para baixo fechado, para cima aberto) e pelo painel, nunca só pela cor.' },
  { name: 'aria-controls', type: 'id', description: 'No <code>button</code>. Aponta para o <code>id</code> do painel.' },
  { name: 'hidden', type: 'boolean', description: 'No painel fechado: oculta também para leitores de tela.' },
  { name: 'aria-disabled', type: 'true', description: 'No <code>button</code> desabilitado. Ele continua na ordem de Tab.' },
  { name: 'h2 … h6', type: 'nível', default: 'h3', description: 'O <code>button</code> fica dentro de um título; escolha o nível conforme a página.' },
];
const behavior = `document.addEventListener('click', (e) => {
  const t = e.target.closest('.uai-accordion-trigger');
  if (!t || t.getAttribute('aria-disabled') === 'true') return;
  const open = t.getAttribute('aria-expanded') !== 'true';
  t.setAttribute('aria-expanded', String(open));
  document.getElementById(t.getAttribute('aria-controls')).hidden = !open;
});`;
---

<UaiuiDocsLayout lead="Esconde conteúdo secundário que a pessoa consulta sob demanda: perguntas frequentes, detalhes de um pedido, seções longas de configurações.">
  <Example code={basic} column label="Accordion com três itens" />

  <h2 id="instalacao">Instalação</h2>
  <ol>
    <li>Importe <code>uaiui-ds/tokens-wrapper.css</code> e coloque os componentes dentro do wrapper <code>.uaiui</code> (veja <a href="/projetos/uaiui/tokens/">Tokens e temas</a>).</li>
    <li>Importe <code>uaiui-ds/components/accordion.css</code>. O código abaixo é o conteúdo desse arquivo.</li>
    <li>Acrescente o comportamento: alternar <code>aria-expanded</code> no botão e <code>hidden</code> no painel.</li>
  </ol>
  <CodeBlock code={css} lang="css" />
  <CodeBlock code={behavior} lang="js" />

  <h2 id="uso">Uso</h2>
  <CodeBlock code={single} />
  <div class="uaiui-docs__callout"><p><strong>Quando usar.</strong> Para esconder conteúdo secundário. Se todo o conteúdo precisa ser lido junto, deixe aberto e sem accordion.</p></div>
  <div class="uaiui-docs__callout"><p><strong>Quando não usar.</strong> Conteúdo essencial ao próximo passo: deixe visível. Alternar painéis do mesmo nível, um por vez: use abas (ainda não existem). Disparar ação: use button. Esconder opções de formulário: veja antes se checkbox ou radio com texto de apoio resolve.</p></div>

  <h2 id="exemplos">Exemplos</h2>
  <Example title="Item desabilitado" description="Cinza, sem resposta ao hover, e continua na ordem de Tab. O painel de quem usa o componente mantém as cores normais." code={disabled} column />

  <h2 id="props">Atributos</h2>
  <PropsTable rows={rows} caption="Atributos do accordion" />
  <p>Itens empilham com espaço entre eles, sem juntar bordas. O grupo (um aberto por vez, ou abrir e fechar todos) ainda não existe como componente.</p>

  <h2 id="acessibilidade">Acessibilidade</h2>
  <ul>
    <li>Botão dentro de um título (<code>h2</code> a <code>h6</code>) com <code>aria-expanded</code> e <code>aria-controls</code>. O painel leva <code>role="region"</code> e <code>aria-labelledby</code> apontando para o botão.</li>
    <li>Teclado: Enter e Espaço abrem e fecham; Tab percorre os cabeçalhos.</li>
    <li>O cabeçalho inteiro é a área de clique, com a altura mínima do botão.</li>
    <li>Anel de foco de 2 px, afastado 2 px, em volta do cabeçalho.</li>
    <li>A cor muda em 100 ms. Se a altura do painel animar, no máximo 200 ms e sem transição com redução de movimento.</li>
  </ul>
</UaiuiDocsLayout>
