---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ColorDecomposer from '../../../components/tools/color-decomposer/ColorDecomposer.astro';

// Título e descrição são os do app (lucas-per/color-decomposer, app/index.html).
// A Ajuda guarda o título da página ao carregar e volta para ele ao fechar.
const title = 'Paletaria: uma cor vira paleta, neutros e estados';
const description =
  'Informe a cor principal e veja a paleta completa, os neutros e os tons de comportamento, em modo claro e escuro, com o contraste de cada texto.';
---

<BaseLayout
  title={title}
  description={description}
  path="/projetos/paletaria/"
  umamiExcludeHash
>
  <ColorDecomposer />
</BaseLayout>

<style is:global>
  /* No celular o cabeçalho do site é sticky e a altura dele vem de
     --header-mobile-height (HeaderMobile.astro). Sem esta folga, o foco e os
     atalhos da Ajuda (scrollIntoView) param com o alvo escondido sob ele
     (WCAG 2.4.11). */
  @media (max-width: 767px) {
    html {
      scroll-padding-top: calc(var(--header-mobile-height) + var(--scale-x2));
    }
  }
</style>
