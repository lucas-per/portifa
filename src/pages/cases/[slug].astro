---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Divider from '../../components/ui/Divider.astro';
import CaseHeader from '../../components/sections/case/CaseHeader.astro';
import SideMenu from '../../components/sections/case/SideMenu.astro';
import CaseAccordion from '../../components/sections/case/CaseAccordion.astro';
import CaseSummary from '../../components/sections/case/CaseSummary.astro';
import CaseContext from '../../components/sections/case/CaseContext.astro';
import CaseProblems from '../../components/sections/case/CaseProblems.astro';
import CaseDiscovery from '../../components/sections/case/CaseDiscovery.astro';
import CaseDelivery from '../../components/sections/case/CaseDelivery.astro';
import CaseImpact from '../../components/sections/case/CaseImpact.astro';
import CasePlansAhead from '../../components/sections/case/CasePlansAhead.astro';
import BackToTopButton from '../../components/sections/case/BackToTopButton.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { estimateReadingTime } from '../../utils/reading-time';

export async function getStaticPaths() {
  const cases = await getCollection('cases', (entry) => entry.id !== 'exemplo-case');
  return cases.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'cases'>;
}

const { entry } = Astro.props;
const { data } = entry;
const readingTime = estimateReadingTime(data.content);
---

<BaseLayout title={`${data.title} — Lucas Pereira`} description={data.shortDescription}>
  <Divider class="case-top-divider" />
  <CaseHeader
    title={data.title}
    status={data.status}
    tags={data.tags}
    publishedDate={data.publishedDate}
    readingTime={readingTime}
  />
  <Divider />
  <div class="case-layout">
    <div class="case-layout__gutter" aria-hidden="true"></div>
    <SideMenu />
    <div class="case-layout__divider" aria-hidden="true"></div>
    <CaseAccordion />
    <div class="case-layout__content">
      <div class="case-layout__content-inner">
        <CaseSummary
          challenge={data.content.summary.challenge}
          solution={data.content.summary.solution}
          results={data.content.summary.results}
        />

        {data.content.context && (
          <>
            <Divider width="156px" />
            <CaseContext {...data.content.context} />
          </>
        )}

        {data.content.problems && (
          <>
            <Divider width="156px" />
            <CaseProblems {...data.content.problems} />
          </>
        )}

        {data.content.discovery && (
          <>
            <Divider width="156px" />
            <CaseDiscovery {...data.content.discovery} />
          </>
        )}

        {data.content.delivery && (
          <>
            <Divider width="156px" />
            <CaseDelivery {...data.content.delivery} />
          </>
        )}

        {data.content.impact && (
          <>
            <Divider width="156px" />
            <CaseImpact {...data.content.impact} />
          </>
        )}

        {data.content.plansAhead && (
          <>
            <Divider width="156px" />
            <CasePlansAhead {...data.content.plansAhead} />
          </>
        )}

        <BackToTopButton />
      </div>
    </div>
  </div>
  <Divider class="case-trail-divider" height="7px" color="var(--surface-bg-tertiary-strong)" />
</BaseLayout>

<style>
  /* .case-layout__gutter e a base de .case-layout__content substituem
     o antigo max-width:1440+padding-left direto em .case-layout: aquele
     esquema centralizava o menu lateral, mas também limitava o fundo
     cinza de .case-layout__content ao boundary de 1440px — em telas
     largas sobrava um vazio off-white entre o fim desse fundo e a
     borda real da viewport (o Figma foi desenhado só em 1440px fixo e
     não previa nenhum dos dois comportamentos). Em vez de capar
     .case-layout, ele volta a ser full-bleed (width:100%) e ganha um
     "gutter" invisível — mesma técnica de preenchedor flex das pontas
     do footer da home (flex:1 1 <base>, dividido igualmente com
     .case-layout__content, que também é flex:1). Como os dois crescem
     na mesma proporção, o gutter sempre absorve exatamente metade do
     espaço excedente acima de 1440px — a mesma posição que o menu
     lateral já tinha quando .case-layout estava capado — enquanto
     .case-layout__content (e seu fundo cinza) absorve a outra metade
     e continua até a borda real da tela. */
  .case-layout {
    width: 100%;
    display: flex;
    /* Sem gap aqui: no Figma o espaço de 48px existe só entre o menu e o
       divisor (fica em .side-menu como margin-right) — entre o divisor e
       o conteúdo é zero, senão o fundo cinza e os divisores de seção
       flutuam longe do divisor vertical em vez de encostar nele. */
    /* Sem padding-top nem padding-right/bottom aqui: o divisor vertical
       precisa encostar direto no divisor horizontal acima (sem lacuna), e
       o fundo cinza de .case-layout__content precisa se estender até a
       borda real da viewport e até o footer — por isso o respiro
       direito/inferior vive dentro do próprio .case-layout__content
       (fica colorido também), não aqui fora dele. */
    align-items: flex-start;
  }

  /* flex-basis = padding-left que .case-layout tinha antes (88px) — em
     telas ≤1440px o gutter fica exatamente nesse tamanho (sem espaço
     excedente pra crescer), reproduzindo o layout atual. min-width:0
     não é estritamente necessário aqui (o elemento não tem conteúdo
     próprio, então não tem largura mínima intrínseca), mas documenta a
     intenção de "pode encolher livremente" e casa com o padrão já
     usado nos preenchedores full-bleed do footer da home. */
  .case-layout__gutter {
    flex: 1 1 var(--scale-x20);
    min-width: 0;
  }

  .case-layout__divider {
    align-self: stretch;
    width: 5px;
    background-color: var(--surface-bg-accent-strong);
  }

  /* flex-basis = max-width de .case-layout__content-inner (977px) —
     SEM somar o padding-right aqui: flex-basis segue box-sizing
     (content-box neste projeto), então o padding declarado abaixo já
     é somado por cima automaticamente durante o layout. Com o menu
     lateral/divisor/gutter, 977 + padding-right(88) fecha exatamente
     os 1440px do frame do Figma quando não há espaço excedente. Sem
     esse basis explícito (em vez do antigo `flex: 1`, que zera o
     basis), o gutter acima ficaria com toda a folga sozinho em vez de
     dividir meio a meio com o conteúdo. */
  .case-layout__content {
    flex: 1 1 977px;
    /* Sem max-width aqui: essa faixa é o fundo cinza inteiro, precisa
       esticar até a borda real da viewport e (decisão de design, diverge
       do Figma atual de propósito — ver design-notes.md) até o footer,
       sem sobrar respiro off-white. O miolo de 977px fica só no filho. */
    padding: var(--scale-x11) var(--scale-x20) var(--scale-x20) 0;
    background-color: var(--surface-bg-neutral-subtle);
  }

  .case-layout__content-inner {
    display: flex;
    flex-direction: column;
    gap: var(--scale-x11);
    max-width: 977px;
  }

  /*
    Divider vermelho antes do footer (Figma, node 275:1149) — só existe
    no mobile. No desktop o fundo cinza de .case-layout__content já
    encosta direto no footer de propósito (ver design-notes.md,
    entrada "col-case-content"), sem essa linha.
  */
  :global(.case-trail-divider) {
    display: none;
  }

  /*
    O primeiro <Divider /> da página (entre o header e o CaseHeader) é
    redundante no mobile: HeaderMobile.astro já renderiza seu próprio
    divisor de 5px colado no fim do header sticky (Figma, node
    254:1007). Os dois juntos criavam uma linha dupla logo abaixo do
    header.
  */
  @media (max-width: 767px) {
    :global(.case-top-divider) {
      display: none;
    }

    :global(.case-trail-divider) {
      display: block;
    }

    .case-layout {
      flex-direction: column;
    }

    /* Sem função no mobile (o menu lateral vira accordion) — some do
       fluxo. Importante: se só ficasse invisível, o flex-basis de
       88px herdado da regra desktop passaria a valer como altura (não
       largura) assim que .case-layout vira flex-direction:column. */
    .case-layout__gutter {
      display: none;
    }

    .case-layout__divider {
      display: none;
    }

    /*
      Sem padding-left aqui (Figma, node 275:471 "col-content-case"): o
      inset de 20px é interno a cada seção (ver comentário em cada
      componente), não deste container compartilhado — os dividers
      estreitos entre seções (Divider width="156px", filhos diretos de
      .case-layout__content-inner) não têm padding próprio, então
      precisam da borda real do container pra ficar 20px à esquerda do
      texto, "vazando" o inset em vez de herdá-lo.
    */
    .case-layout__content {
      /* Reseta o flex-basis em calc(977px + 88px) da regra desktop:
         em flex-direction:column esse valor passaria a ser lido como
         altura (o eixo principal muda de largura pra altura), não
         largura — sem isso o container tentaria nascer com ~1065px
         de altura antes de crescer/encolher pro conteúdo real. */
      flex: 1;
      padding: var(--scale-x7) var(--scale-x5) var(--scale-x11) 0;
    }

    .case-layout__content-inner {
      max-width: none;
    }
  }
</style>
